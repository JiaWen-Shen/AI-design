<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.karenshen.design-context.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON3}}</string>
        <string>{{SKILL_DIR}}/scripts/sync.py</string>
        <string>--all-registered</string>
        <string>--quiet</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{HOME}}/.cache/design-context/logs/cron.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/.cache/design-context/logs/cron.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>
</dict>
</plist>
